{
  "name": "@skillmesh/db",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate:local": "wrangler d1 migrations apply skillmesh-db --local --config ../../apps/api/wrangler.toml",
    "migrate:remote": "wrangler d1 migrations apply skillmesh-db --remote --config ../../apps/api/wrangler.toml",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241224.0",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.0.0"
  }
}
